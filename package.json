{
  "name": "samebase-base",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "dev": "node ./scripts/run-context-dev.ts",
    "dev:primary": "node ./scripts/run-primary-dev.ts",
    "dev:frontend": "vp dev",
    "dev:worktree": "node ./scripts/run-worktree-dev.ts",
    "check": "vp check && vp run typecheck && vp test && vp run verify:cloudflare-redirects && vp run verify:dev-launcher-version",
    "build": "vp run check && vp build",
    "deploy": "convex-hosting deploy --build \"vp run build && node ./scripts/ensure-convex-auth.ts --prod\" --dist dist/client --html-handling none --not-found-handling single-page-application",
    "deploy:dev": "convex-hosting deploy --dev --build \"vp run build && node ./scripts/ensure-convex-auth.ts\" --dist dist/client --html-handling none --not-found-handling single-page-application",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "generate:cloudflare-redirects": "node ./scripts/generate-cloudflare-redirects.ts",
    "generate:dev-launcher-version": "node ./scripts/generate-dev-launcher-version.ts --write",
    "lint": "vp lint --report-unused-disable-directives",
    "preview": "vp preview",
    "prepare": "vp config --no-agent",
    "test": "vp test",
    "typecheck": "tsc && vp run typecheck:node && tsc --project convex/tsconfig.json",
    "typecheck:node": "tsc --project tsconfig.node.json",
    "verify:cloudflare-redirects": "vp run generate:cloudflare-redirects && git diff --exit-code -- public/_redirects",
    "verify:dev-launcher-version": "node ./scripts/generate-dev-launcher-version.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "^0.0.94",
    "@samebase/convex-hosting": "^0.13.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "lucide-react": "^1.14.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.23",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "shadcn": "^4.16.1",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.1.1"
}
